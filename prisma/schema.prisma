generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum HelpMode {
  WITH_IMAGE
  WITHOUT_IMAGE
  LISTEN
}

enum ExerciseType {
  ONE_VOWEL
  ALL_VOWELS
  INITIAL_VOWEL
  MIXED
  SINGLE_CONSONANT
}

enum TargetKind {
  VOWEL
  CONSONANT
}

enum AnswerOutcome {
  CORRECT
  INCORRECT
  ASSISTED
  SKIPPED
}

enum ProgressState {
  NEW
  LEARNING
  ALMOST_LEARNED
  LEARNED
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum DailyActivityType {
  INITIAL_SOUND
  SYLLABLE_BUILD
  TRACE_LETTER
}

enum DailyJourneyStatus {
  ACTIVE
  COMPLETED
}

enum LearningActivityType {
  CASE_MATCH
  NAME_TILES
  SYLLABLE_COUNT
  INITIAL_SOUND
  SYLLABLE_BUILD
  ENGLISH_CASE_MATCH
  ENGLISH_VOCABULARY
  ENGLISH_INITIAL_SOUND
  ENGLISH_CVC_BUILD
  ENGLISH_SIGHT_WORD
  MATH_NUMBER_QUANTITY
  MATH_COUNT_OBJECTS
  MATH_COMPARE_QUANTITIES
  MATH_NUMBER_SEQUENCE
  MATH_ADDITION
  MATH_SUBTRACTION
  MATH_PLACE_VALUE
  MATH_COMPARE_TWO_DIGIT
  MATH_ADDITION_TWO_DIGIT
  MATH_SUBTRACTION_TWO_DIGIT
  MATH_STORY_ADDITION
  MATH_STORY_SUBTRACTION
  LOGIC_SHAPE
  LOGIC_SORT
  LOGIC_PATTERN
  LOGIC_POSITION
  LOGIC_MEASURE
  STORY_CHARACTER
  STORY_SETTING
  STORY_SEQUENCE
  STORY_COMPREHENSION
  STORY_VOCABULARY
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ChildProfile {
  id                  String                    @id @default(uuid())
  nickname            String
  avatar              String?
  practiceName        String?
  nameActivityEnabled Boolean                   @default(false)
  active              Boolean                   @default(true)
  createdAt           DateTime                  @default(now())
  sessions            GameSession[]
  attempts            Attempt[]
  progress            WordSkillProgress[]
  letterProgress      LetterSkillProgress[]
  dailyJourneys       DailyJourney[]
  activitySessions    LearningActivitySession[]
  activityProgress    ActivitySkillProgress[]

  @@index([active])
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  color     String   @default("#B9DCCB")
  createdAt DateTime @default(now())
  words     Word[]
}

model Word {
  id              String                  @id @default(uuid())
  text            String
  normalizedText  String
  imagePath       String?
  audioPath       String?
  imageMime       String?
  audioMime       String?
  syllables       String[]                @default([])
  categoryId      String
  category        Category                @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  difficulty      Int                     @default(1)
  active          Boolean                 @default(true)
  deletedAt       DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  configurations  ExerciseConfiguration[]
  attempts        Attempt[]
  progress        WordSkillProgress[]
  sessionItems    SessionExercise[]
  dailyActivities DailyActivity[]
  activityItems   LearningActivityItem[]

  @@unique([normalizedText, categoryId])
  @@index([active, deletedAt, difficulty, categoryId])
}

model LearningActivitySession {
  id                String                    @id @default(uuid())
  childProfileId    String
  childProfile      ChildProfile              @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  activityType      LearningActivityType
  mode              String
  requestedCount    Int
  actualCount       Int                       @default(0)
  requestKey        String?                   @unique
  categoryId        String?
  difficulty        Int?
  status            SessionStatus             @default(ACTIVE)
  score             Int?
  startedAt         DateTime                  @default(now())
  completedAt       DateTime?
  reviewOfSessionId String?
  reviewOf          LearningActivitySession?  @relation("LearningSessionReviews", fields: [reviewOfSessionId], references: [id], onDelete: SetNull)
  reviewSessions    LearningActivitySession[] @relation("LearningSessionReviews")
  items             LearningActivityItem[]

  @@index([childProfileId, activityType, startedAt])
  @@index([status, startedAt])
  @@index([reviewOfSessionId])
}

model LearningActivityItem {
  id                  String                  @id @default(uuid())
  sessionId           String
  session             LearningActivitySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  wordId              String?
  word                Word?                   @relation(fields: [wordId], references: [id], onDelete: SetNull)
  position            Int
  targetKey           String
  prompt              Json
  options             Json
  correctResponse     Json
  firstResponse       Json?
  outcome             AnswerOutcome?
  helpUsed            Boolean                 @default(false)
  responseTimeMs      Int?
  technicalSkipReason String?
  answeredAt          DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@unique([sessionId, position])
  @@unique([sessionId, targetKey])
  @@index([wordId])
  @@index([sessionId, outcome])
}

model ActivitySkillProgress {
  id               String               @id @default(uuid())
  childProfileId   String
  childProfile     ChildProfile         @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  activityType     LearningActivityType
  skillKey         String
  mode             String
  state            ProgressState        @default(NEW)
  attempts         Int                  @default(0)
  firstTryCorrect  Int                  @default(0)
  errorCount       Int                  @default(0)
  assistedCount    Int                  @default(0)
  skippedCount     Int                  @default(0)
  recentAccuracy   Float                @default(0)
  distinctSessions Int                  @default(0)
  lastPracticedAt  DateTime?
  updatedAt        DateTime             @updatedAt

  @@unique([childProfileId, activityType, skillKey, mode])
  @@index([childProfileId, activityType, updatedAt])
}

model DailyJourney {
  id              String             @id @default(uuid())
  childProfileId  String
  childProfile    ChildProfile       @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  dateKey         String
  durationMinutes Int                @default(5)
  status          DailyJourneyStatus @default(ACTIVE)
  rewardStage     Int?
  rewardName      String?
  startedAt       DateTime           @default(now())
  completedAt     DateTime?
  activities      DailyActivity[]

  @@unique([childProfileId, dateKey, durationMinutes])
  @@index([childProfileId, completedAt])
}

model DailyActivity {
  id        String                @id @default(uuid())
  journeyId String
  journey   DailyJourney          @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  type      DailyActivityType
  position  Int
  wordId    String?
  word      Word?                 @relation(fields: [wordId], references: [id], onDelete: SetNull)
  wordText  String?
  options   String[]              @default([])
  outcome   AnswerOutcome?
  createdAt DateTime              @default(now())
  targets   DailyActivityTarget[]

  @@unique([journeyId, position])
  @@index([wordId])
}

model DailyActivityTarget {
  id             String         @id @default(uuid())
  activityId     String
  activity       DailyActivity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  targetPosition Int
  expectedPiece  String
  selectedPiece  String?
  outcome        AnswerOutcome?
  helpUsed       Boolean        @default(false)
  responseTimeMs Int?
  answeredAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([activityId, targetPosition])
  @@index([activityId, outcome])
}

model ExerciseConfiguration {
  id              String            @id @default(uuid())
  wordId          String
  word            Word              @relation(fields: [wordId], references: [id], onDelete: Cascade)
  type            ExerciseType
  hiddenPositions Int[]
  active          Boolean           @default(true)
  createdAt       DateTime          @default(now())
  attempts        Attempt[]
  sessionItems    SessionExercise[]

  @@index([wordId, active, type])
}

model GameSession {
  id                String            @id @default(uuid())
  childProfileId    String
  childProfile      ChildProfile      @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  helpMode          HelpMode
  exerciseType      ExerciseType
  requestedCount    Int
  actualCount       Int               @default(0)
  requestKey        String?           @unique
  includeLearned    Boolean           @default(false)
  categoryId        String?
  difficulty        Int?
  status            SessionStatus     @default(ACTIVE)
  score             Int?
  startedAt         DateTime          @default(now())
  completedAt       DateTime?
  attempts          Attempt[]
  exercises         SessionExercise[]
  reviewOfSessionId String?
  reviewOf          GameSession?      @relation("SessionReviews", fields: [reviewOfSessionId], references: [id], onDelete: SetNull)
  reviewSessions    GameSession[]     @relation("SessionReviews")

  @@index([childProfileId, startedAt])
  @@index([status, startedAt])
  @@index([reviewOfSessionId])
}

model SessionExercise {
  id              String                @id @default(uuid())
  sessionId       String
  session         GameSession           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  wordId          String
  word            Word                  @relation(fields: [wordId], references: [id], onDelete: Restrict)
  configurationId String
  configuration   ExerciseConfiguration @relation(fields: [configurationId], references: [id], onDelete: Restrict)
  position        Int
  targetPosition  Int?
  options         String[]              @default([])
  createdAt       DateTime              @default(now())
  targets         SessionTarget[]
  attempt         Attempt?

  @@unique([sessionId, wordId])
  @@unique([sessionId, position])
  @@index([wordId])
  @@index([configurationId])
}

model SessionTarget {
  id                String          @id @default(uuid())
  sessionExerciseId String
  sessionExercise   SessionExercise @relation(fields: [sessionExerciseId], references: [id], onDelete: Cascade)
  targetPosition    Int
  expectedGrapheme  String
  selectedLetter    String?
  outcome           AnswerOutcome?
  helpUsed          Boolean         @default(false)
  audioPlayCount    Int             @default(0)
  responseTimeMs    Int?
  answeredAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([sessionExerciseId, targetPosition])
  @@index([sessionExerciseId, outcome])
}

model Attempt {
  id                    String                @id @default(uuid())
  sessionId             String
  session               GameSession           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  childProfileId        String
  childProfile          ChildProfile          @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  wordId                String
  word                  Word                  @relation(fields: [wordId], references: [id], onDelete: Cascade)
  configurationId       String
  configuration         ExerciseConfiguration @relation(fields: [configurationId], references: [id], onDelete: Restrict)
  exerciseType          ExerciseType
  helpMode              HelpMode
  firstTryCorrectSpaces Int
  totalSpaces           Int
  errorCount            Int
  audioPlayCount        Int                   @default(0)
  responseTimeMs        Int
  targetKind            TargetKind?
  targetLetter          String?
  targetPosition        Int?
  options               String[]              @default([])
  createdAt             DateTime              @default(now())
  answers               AttemptAnswer[]
  sessionExerciseId     String?               @unique
  sessionExercise       SessionExercise?      @relation(fields: [sessionExerciseId], references: [id], onDelete: Restrict)
  assistedSpaces        Int                   @default(0)
  incorrectSpaces       Int                   @default(0)
  skippedSpaces         Int                   @default(0)

  @@index([childProfileId, wordId, createdAt])
  @@index([sessionId, createdAt])
}

model AttemptAnswer {
  id               String        @id @default(uuid())
  attemptId        String
  attempt          Attempt       @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  position         Int
  selectedLetter   String?       @map("selectedVowel")
  expectedGrapheme String
  correctFirstTry  Boolean
  errorCount       Int
  outcome          AnswerOutcome
  helpUsed         Boolean       @default(false)

  @@index([attemptId, position])
}

model LetterSkillProgress {
  id              String       @id @default(uuid())
  childProfileId  String
  childProfile    ChildProfile @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  targetKind      TargetKind
  targetLetter    String
  exerciseType    ExerciseType
  attempts        Int          @default(0)
  firstTryCorrect Int          @default(0)
  errorCount      Int          @default(0)
  lastPracticedAt DateTime?
  updatedAt       DateTime     @updatedAt

  @@unique([childProfileId, targetKind, targetLetter, exerciseType])
  @@index([childProfileId, targetKind, updatedAt])
}

model WordSkillProgress {
  id               String        @id @default(uuid())
  childProfileId   String
  childProfile     ChildProfile  @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  wordId           String
  word             Word          @relation(fields: [wordId], references: [id], onDelete: Cascade)
  exerciseType     ExerciseType
  helpMode         HelpMode
  state            ProgressState @default(NEW)
  attempts         Int           @default(0)
  firstTryCorrect  Int           @default(0)
  recentAccuracy   Float         @default(0)
  distinctSessions Int           @default(0)
  lastPracticedAt  DateTime?
  updatedAt        DateTime      @updatedAt

  @@unique([childProfileId, wordId, exerciseType, helpMode])
  @@index([childProfileId, state, updatedAt])
}

model AppSettings {
  id                       String   @id @default("default")
  hintAfterErrors          Int      @default(2)
  feedbackDelayMs          Int      @default(900)
  incorrectFeedbackDelayMs Int      @default(2200)
  activeConsonants         String[] @default(["M", "P", "L", "S", "T", "N"])
  updatedAt                DateTime @updatedAt
}
