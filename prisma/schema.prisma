generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum HelpMode {
  WITH_IMAGE
  WITHOUT_IMAGE
  LISTEN
}

enum ExerciseType {
  ONE_VOWEL
  ALL_VOWELS
  INITIAL_VOWEL
  MIXED
}

enum ProgressState {
  NEW
  LEARNING
  ALMOST_LEARNED
  LEARNED
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ChildProfile {
  id        String              @id @default(uuid())
  nickname  String
  avatar    String?
  active    Boolean             @default(true)
  createdAt DateTime            @default(now())
  sessions  GameSession[]
  attempts  Attempt[]
  progress  WordSkillProgress[]

  @@index([active])
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  color     String   @default("#B9DCCB")
  createdAt DateTime @default(now())
  words     Word[]
}

model Word {
  id             String                  @id @default(uuid())
  text           String
  normalizedText String
  imagePath      String?
  audioPath      String?
  imageMime      String?
  audioMime      String?
  categoryId     String
  category       Category                @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  difficulty     Int                     @default(1)
  active         Boolean                 @default(true)
  deletedAt      DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  configurations ExerciseConfiguration[]
  attempts       Attempt[]
  progress       WordSkillProgress[]
  sessionItems   SessionExercise[]

  @@unique([normalizedText, categoryId])
  @@index([active, deletedAt, difficulty, categoryId])
}

model ExerciseConfiguration {
  id              String       @id @default(uuid())
  wordId          String
  word            Word         @relation(fields: [wordId], references: [id], onDelete: Cascade)
  type            ExerciseType
  hiddenPositions Int[]
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now())
  attempts        Attempt[]
  sessionItems    SessionExercise[]

  @@index([wordId, active, type])
}

model GameSession {
  id             String        @id @default(uuid())
  childProfileId String
  childProfile   ChildProfile  @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  helpMode       HelpMode
  exerciseType   ExerciseType
  requestedCount Int
  actualCount    Int           @default(0)
  requestKey     String?       @unique
  includeLearned Boolean       @default(false)
  categoryId     String?
  difficulty     Int?
  status         SessionStatus @default(ACTIVE)
  score          Int?
  startedAt      DateTime      @default(now())
  completedAt    DateTime?
  attempts       Attempt[]
  exercises      SessionExercise[]

  @@index([childProfileId, startedAt])
  @@index([status, startedAt])
}

model SessionExercise {
  id              String                @id @default(uuid())
  sessionId       String
  session         GameSession           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  wordId          String
  word            Word                  @relation(fields: [wordId], references: [id], onDelete: Restrict)
  configurationId String
  configuration   ExerciseConfiguration @relation(fields: [configurationId], references: [id], onDelete: Restrict)
  position        Int
  createdAt       DateTime              @default(now())

  @@unique([sessionId, wordId])
  @@unique([sessionId, position])
  @@index([wordId])
  @@index([configurationId])
}

model Attempt {
  id                    String                @id @default(uuid())
  sessionId             String
  session               GameSession           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  childProfileId        String
  childProfile          ChildProfile          @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  wordId                String
  word                  Word                  @relation(fields: [wordId], references: [id], onDelete: Cascade)
  configurationId       String
  configuration         ExerciseConfiguration @relation(fields: [configurationId], references: [id], onDelete: Restrict)
  exerciseType          ExerciseType
  helpMode              HelpMode
  firstTryCorrectSpaces Int
  totalSpaces           Int
  errorCount            Int
  audioPlayCount        Int                   @default(0)
  responseTimeMs        Int
  createdAt             DateTime              @default(now())
  answers               AttemptAnswer[]

  @@index([childProfileId, wordId, createdAt])
  @@index([sessionId, createdAt])
}

model AttemptAnswer {
  id               String  @id @default(uuid())
  attemptId        String
  attempt          Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  position         Int
  selectedVowel    String
  expectedGrapheme String
  correctFirstTry  Boolean
  errorCount       Int

  @@index([attemptId, position])
}

model WordSkillProgress {
  id               String        @id @default(uuid())
  childProfileId   String
  childProfile     ChildProfile  @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  wordId           String
  word             Word          @relation(fields: [wordId], references: [id], onDelete: Cascade)
  exerciseType     ExerciseType
  helpMode         HelpMode
  state            ProgressState @default(NEW)
  attempts         Int           @default(0)
  firstTryCorrect  Int           @default(0)
  recentAccuracy   Float         @default(0)
  distinctSessions Int           @default(0)
  lastPracticedAt  DateTime?
  updatedAt        DateTime      @updatedAt

  @@unique([childProfileId, wordId, exerciseType, helpMode])
  @@index([childProfileId, state, updatedAt])
}

model AppSettings {
  id              String   @id @default("default")
  hintAfterErrors Int      @default(2)
  feedbackDelayMs Int      @default(900)
  updatedAt       DateTime @updatedAt
}
